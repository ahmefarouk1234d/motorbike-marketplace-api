NODE_ENV=
PORT=
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=
CLIENT_URL=

# Firebase Storage (from the service account JSON you download in
# Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key on one line, keeping the literal \n sequences and the
# surrounding quotes: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Bucket name only, no gs:// prefix, e.g. my-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
