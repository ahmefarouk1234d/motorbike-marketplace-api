NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1/motorbike-marketplace
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Base URL of the frontend. Verification and password-reset links are built from it.
CLIENT_URL=http://localhost:3000

# Firebase Storage (from the service account JSON you download in
# Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key on one line, keeping the literal \n sequences and the
# surrounding quotes: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
# Bucket name only, no gs:// prefix, e.g. my-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# SMTP for verification and password-reset mail. Leave blank to run without
# email: those endpoints still answer normally, and the failure is logged.
# Port 465 uses implicit TLS; 587 uses STARTTLS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Motorbike Marketplace <no-reply@example.com>"

# Optional. Tests fall back to this database; defaults to a local test database.
MONGO_URI_TEST=mongodb://127.0.0.1/motorbike-marketplace-test
